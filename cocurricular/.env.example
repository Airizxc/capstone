# ==============================================================================
# Co-Curricular Module Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' in your local environment:
#      copy .env.example .env   (Windows)
#      cp .env.example .env     (Linux/macOS)
# 2. Replace the placeholder values below with your actual credentials.
# 3. NEVER commit your real '.env' file to Git! It is ignored by .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenAI API Configuration (Server-Side Announcement Generation)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
COCURRICULAR_OPENAI_MODEL=gpt-4.1

# ------------------------------------------------------------------------------
# 2. Firebase Web Client Configuration (Web Push SDK & In-App Alerts)
# Retrieve from: Firebase Console > Project Settings > General > Your apps
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY_HERE
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=1:YOUR_MESSAGING_SENDER_ID:web:YOUR_APP_ID_HASH
# VAPID Key: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
FIREBASE_VAPID_KEY=YOUR_FIREBASE_VAPID_PUBLIC_KEY_HERE

# ------------------------------------------------------------------------------
# 3. Firebase Admin / FCM HTTP v1 Server-Side Dispatcher
# Option A: Path to service account JSON (recommended)
FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json
# Option B: Direct credentials (optional alternative to service account file)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. Database Connection Settings (Optional Overrides)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cocurricular_db
DB_USER=root
DB_PASS=
